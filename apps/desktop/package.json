{
  "name": "@storyboard/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node ../../tools/dist-temizle.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b",
    "paketle": "npm run build && electron-builder --win --config electron-builder.json",
    "paketle:tasinabilir": "npm run build && electron-builder --dir --config electron-builder.json && node ../../tools/ikon-gom.mjs && electron-builder --win portable --prepackaged release/win-unpacked --config electron-builder.json"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@storyboard/core": "*",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "yjs": "^13.6.20"
  },
  "license": "GPL-3.0-only"
}
