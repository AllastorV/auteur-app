{
  "name": "storyboard-studio",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop workspace for screenwriting, storyboarding, and worldbuilding, with an optional collaboration client",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @storyboard/desktop",
    "dev:web": "npm run dev --workspace @storyboard/web",
    "dev:server": "npm run dev --workspace @storyboard/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc -b --pretty && npm run typecheck:tests",
    "postinstall": ""
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "GPL-3.0-only",
  "author": "AllastorV",
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "leveldown@5.6.0": true
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  }
}
